PROGRAMS = winegcc

SOURCES = \
	utils.c \
	winegcc.c \
	winegcc.man.in

winegcc_SYMLINKS = winecpp wineg++

winegcc_EXTRADEFS = \
	-DINCLUDEDIR="\"${includedir}\"" \
	-DBINDIR="\"${bindir}\"" \
	-DLIBDIR="\"${libdir}\"" \
	-DCC="\"$(PLAIN_CC)\"" \
	-DCPP="\"$(CPPBIN)\"" \
	-DCXX="\"$(PLAIN_CXX)\"" \
	-DLD="\"$(LD)\""

INSTALL_DEV = $(PROGRAMS) $(winegcc_SYMLINKS)
